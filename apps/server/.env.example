# Copy to .env and choose your own values. .env is never committed.

# What friends type to get into the Room.
JOIN_CODE=

# What the machine wired to the speaker types to take playback.
# Deliberately not the same as JOIN_CODE: holding one must not grant the other.
PLAYER_PASSWORD=

# Where the Room is remembered. See the README for making the project and the
# service account; the Room will not open without these.
FIREBASE_PROJECT_ID=

# From the service account key file. The private key is multi-line in that file
# and one line here, with the newlines written as \n. Keep the quotes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Set this instead of the two above to talk to the local Firestore emulator,
# which wants a project id and no credentials.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
